#!/bin/zsh
set -eu

label="app.aster.helper"
dest="${2:-/}"
app="${dest%/}/Applications/Aster.app"
helper="/Library/Application Support/Aster/aster-helper"
plist="/Library/LaunchDaemons/${label}.plist"
runtime="/Library/Application Support/Aster/runtime"
singbox="/Library/Application Support/Aster/cores/sing-box"

install -d -o root -g wheel -m 700 "/Library/Application Support/Aster" "$runtime" "/Library/Application Support/Aster/cores"
console_uid="$(stat -f '%u' /dev/console)"
if [[ "$console_uid" -le 0 ]]; then
  echo "Aster installation requires a logged-in console user" >&2
  exit 1
fi
if [[ ! -x "$singbox" ]]; then
  echo "Aster network component is incomplete (missing managed sing-box)" >&2
  exit 1
fi
printf '%s\n' "$console_uid" > "/Library/Application Support/Aster/allowed-uid"
chown root:wheel "/Library/Application Support/Aster/allowed-uid"
chmod 600 "/Library/Application Support/Aster/allowed-uid"
chown root:wheel "$helper"
chmod 755 "$helper"
chown root:wheel "$singbox"
chmod 755 "$singbox"
chown root:wheel "$plist"
chmod 644 "$plist"
launchctl bootout system "$plist" >/dev/null 2>&1 || true
launchctl bootstrap system "$plist"
exit 0
